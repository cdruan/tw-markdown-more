title: $:/plugins/cdr/markdown-more/styles/example-block
tags: [[$:/tags/Stylesheet]]

.md-example-container {
	display: flex;
	align-items: top;
	gap: 20px;
	margin: 1em 0 1em 1.5em;
}
.md-example-container .md-example-text {
	display: inline-block;
	flex: 1;
	vertical-align: top;
}
.md-example-container .md-example-comment {
	display: inline-block;
	flex-shrink: 0;
	width: 50%;
	margin: 2px 0px;
	font-size: 90%;
	font-style: italic;
	line-height: 1.2;
	color: <<colour muted-foreground>>;
}